# ========================================
# 📄 RFID GATE - Configurazione Sistema
# ========================================

# ===========================================
# 📡 CONFIGURAZIONE MQTT
# ===========================================
MQTT_BROKER=mqbrk.ddns.net
MQTT_PORT=8883
MQTT_USERNAME=palestraUser
MQTT_PASSWORD=28dade03$
MQTT_USE_TLS=True

# ===========================================
# 🏷️ IDENTIFICAZIONE TORNELLO
# ===========================================
TORNELLO_ID=tornello_01

# ===========================================
# 🔄 SISTEMA BIDIREZIONALE
# ===========================================
BIDIRECTIONAL_MODE=True
ENABLE_IN_READER=True
ENABLE_OUT_READER=False

# ===========================================
# 📱 CONFIGURAZIONE RFID READER INGRESSO
# ===========================================
# Tipo lettore RFID: mfrc522 o pn532
RFID_IN_READER_TYPE=mfrc522

# Configurazione MFRC522 (se RFID_IN_READER_TYPE=mfrc522)
RFID_IN_RST_PIN=22
RFID_IN_SDA_PIN=8

# Configurazione PN532 (se RFID_IN_READER_TYPE=pn532)
RFID_IN_PN532_INTERFACE=i2c
RFID_IN_PN532_I2C_ADDRESS=0x24
RFID_IN_PN532_SPI_BUS=0
RFID_IN_PN532_SPI_DEVICE=0
RFID_IN_PN532_UART_PORT=/dev/serial0
RFID_IN_PN532_UART_BAUDRATE=115200

RFID_IN_ENABLE=True

# ===========================================
# 📱 CONFIGURAZIONE RFID READER USCITA
# ===========================================
# Tipo lettore RFID: mfrc522 o pn532  
RFID_OUT_READER_TYPE=pn532

# Configurazione MFRC522 (se RFID_OUT_READER_TYPE=mfrc522)
RFID_OUT_RST_PIN=25
RFID_OUT_SDA_PIN=7

# Configurazione PN532 (se RFID_OUT_READER_TYPE=pn532)
RFID_OUT_PN532_INTERFACE=i2c
RFID_OUT_PN532_I2C_ADDRESS=0x25
RFID_OUT_PN532_SPI_BUS=1
RFID_OUT_PN532_SPI_DEVICE=0
RFID_OUT_PN532_UART_PORT=/dev/serial1
RFID_OUT_PN532_UART_BAUDRATE=115200

RFID_OUT_ENABLE=False

# Relè IN
RELAY_IN_PIN=18
RELAY_IN_ACTIVE_TIME=2
RELAY_IN_ACTIVE_LOW=True
RELAY_IN_INITIAL_STATE=HIGH
RELAY_IN_ENABLE=True

# Relè OUT (opzionale)
RELAY_OUT_PIN=19
RELAY_OUT_ACTIVE_TIME=2
RELAY_OUT_ACTIVE_LOW=True
RELAY_OUT_INITIAL_STATE=HIGH
RELAY_OUT_ENABLE=False

# Autenticazione
AUTH_ENABLED=True
AUTH_TIMEOUT=10
AUTH_TOPIC_SUFFIX=auth_response

# Apertura Manuale
MANUAL_OPEN_ENABLED=True
MANUAL_OPEN_TOPIC_SUFFIX=manual_open
MANUAL_OPEN_RESPONSE_TOPIC_SUFFIX=manual_response
MANUAL_OPEN_TIMEOUT=10
MANUAL_OPEN_AUTH_REQUIRED=True

# Sistema Offline
OFFLINE_MODE_ENABLED=True
OFFLINE_ALLOW_ACCESS=True
OFFLINE_SYNC_ENABLED=True
OFFLINE_STORAGE_FILE=offline_queue.json
OFFLINE_MAX_QUEUE_SIZE=1000
CONNECTION_CHECK_INTERVAL=30
CONNECTION_RETRY_ATTEMPTS=3

# Logging
LOG_DIRECTORY=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
ENABLE_CONSOLE_LOG=False

# RFID Debounce
RFID_DEBOUNCE_TIME=2.0

# ===========================================
# 🔧 CONFIGURAZIONE FORMATO UID CARD
# ===========================================
# Modalità formato UID:
# - 'remove_suffix': Rimuove N caratteri dalla fine (es. C67BD90561 → C67BD905)
# - 'truncate': Prende primi N caratteri (es. C67BD90561 → C67BD905)
# - 'take_last': Prende ultimi N caratteri
# - 'fixed_length': Padding/truncate a lunghezza fissa
UID_FORMAT_MODE=remove_suffix

# Numero caratteri da rimuovere/prendere (dipende da modalità)
UID_CHARS_COUNT=2

# Lunghezza finale desiderata (per fixed_length mode)
UID_TARGET_LENGTH=8

# Debug: mostra conversioni UID nei log
UID_DEBUG_MODE=True

# ===========================================
# 🔧 ESEMPI CONFIGURAZIONI COMUNI
# ===========================================

# 📝 CONFIGURAZIONE 1: Solo Ingresso MFRC522 (Unidirezionale)
# BIDIRECTIONAL_MODE=False
# ENABLE_IN_READER=True
# ENABLE_OUT_READER=False
# RFID_IN_READER_TYPE=mfrc522
# RFID_IN_RST_PIN=22
# RFID_IN_SDA_PIN=8
# RELAY_IN_PIN=18
# RELAY_OUT_ENABLE=False

# 📝 CONFIGURAZIONE 2: Solo Ingresso PN532 (Unidirezionale)
# BIDIRECTIONAL_MODE=False
# ENABLE_IN_READER=True
# ENABLE_OUT_READER=False
# RFID_IN_READER_TYPE=pn532
# RFID_IN_PN532_INTERFACE=i2c
# RFID_IN_PN532_I2C_ADDRESS=0x24
# RELAY_IN_PIN=18
# RELAY_OUT_ENABLE=False

# 📝 CONFIGURAZIONE 3: Sistema Bidirezionale PN532 (RACCOMANDATO)
# BIDIRECTIONAL_MODE=True
# ENABLE_IN_READER=True
# ENABLE_OUT_READER=True
# RFID_IN_READER_TYPE=pn532
# RFID_OUT_READER_TYPE=pn532
# RFID_IN_PN532_INTERFACE=i2c
# RFID_IN_PN532_I2C_ADDRESS=0x24
# RFID_OUT_PN532_INTERFACE=i2c
# RFID_OUT_PN532_I2C_ADDRESS=0x25
# RELAY_IN_PIN=18
# RELAY_OUT_PIN=19

# 📝 CONFIGURAZIONE 4: Mix MFRC522 IN + PN532 OUT
# BIDIRECTIONAL_MODE=True
# ENABLE_IN_READER=True
# ENABLE_OUT_READER=True
# RFID_IN_READER_TYPE=mfrc522
# RFID_OUT_READER_TYPE=pn532
# RFID_IN_RST_PIN=22
# RFID_IN_SDA_PIN=8
# RFID_OUT_PN532_INTERFACE=i2c
# RFID_OUT_PN532_I2C_ADDRESS=0x25

# ===========================================
# 📋 WIRING PN532 I2C (RACCOMANDATO)
# ===========================================
# PN532 IN (Address 0x24):
#   VCC → 3.3V (Pin 1)
#   GND → GND  (Pin 6)
#   SDA → GPIO 2 (Pin 3)
#   SCL → GPIO 3 (Pin 5)
#
# PN532 OUT (Address 0x25):
#   VCC → 3.3V (Pin 17)
#   GND → GND  (Pin 20)
#   SDA → GPIO 2 (Pin 3) - STESSO BUS I2C
#   SCL → GPIO 3 (Pin 5) - STESSO BUS I2C
#
# IMPORTANTE: Due PN532 sullo stesso bus I2C 
# devono avere indirizzi diversi (0x24, 0x25)
# Configurare indirizzo tramite jumper su modulo

# ===========================================
# 📋 WIRING MFRC522 SPI (ESISTENTE)
# ===========================================
# MFRC522 IN:
#   VCC → 3.3V (Pin 1)
#   RST → GPIO 22 (Pin 15)
#   GND → GND (Pin 6)
#   MISO → GPIO 9 (Pin 21)
#   MOSI → GPIO 10 (Pin 19)
#   SCK → GPIO 11 (Pin 23)
#   SDA → GPIO 8 (Pin 24)
#
# MFRC522 OUT:
#   VCC → 3.3V (Pin 17)
#   RST → GPIO 25 (Pin 22)
#   GND → GND (Pin 25)
#   MISO → GPIO 9 (Pin 21) - CONDIVISO
#   MOSI → GPIO 10 (Pin 19) - CONDIVISO
#   SCK → GPIO 11 (Pin 23) - CONDIVISO
#   SDA → GPIO 7 (Pin 26)

# ===========================================
# 🚀 COME SWITCHARE A PN532
# ===========================================
# 1. Installa dipendenze: pip install -r requirements.txt
# 2. Collega hardware PN532 secondo schema I2C sopra
# 3. Modifica questa configurazione:
#    RFID_IN_READER_TYPE=pn532
#    RFID_OUT_READER_TYPE=pn532
# 4. Riavvia sistema: sudo systemctl restart rfid-gate
# 5. Test: python3 scripts/test_readers.py
