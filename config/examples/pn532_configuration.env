# ================================================
# CONFIGURAZIONE LETTORI RFID - SUPPORTO MULTIPLO
# ================================================

# TIPO DI LETTORE RFID (mfrc522 | pn532)
# Cambia questi valori per switchare tra i lettori
RFID_IN_READER_TYPE=pn532
RFID_OUT_READER_TYPE=pn532

# ================================================
# CONFIGURAZIONI PN532 (solo se READER_TYPE=pn532)
# ================================================

# INTERFACCIA PN532 (i2c | spi | uart)
RFID_IN_PN532_INTERFACE=i2c
RFID_OUT_PN532_INTERFACE=i2c

# --- Configurazioni I2C ---
# Indirizzi I2C diversi per IN e OUT (importante!)
RFID_IN_PN532_I2C_ADDRESS=0x24
RFID_OUT_PN532_I2C_ADDRESS=0x25

# --- Configurazioni SPI (alternative) ---
RFID_IN_PN532_SPI_BUS=0
RFID_IN_PN532_SPI_DEVICE=0
RFID_OUT_PN532_SPI_BUS=1
RFID_OUT_PN532_SPI_DEVICE=0

# --- Configurazioni UART (alternative) ---
RFID_IN_PN532_UART_PORT=/dev/serial0
RFID_IN_PN532_UART_BAUDRATE=115200
RFID_OUT_PN532_UART_PORT=/dev/serial1
RFID_OUT_PN532_UART_BAUDRATE=115200

# ================================================
# CONFIGURAZIONI MFRC522 (solo se READER_TYPE=mfrc522)
# ================================================
# Queste rimangono invariate per compatibilità

# PIN RFID IN (lettore entrata)
RFID_IN_RST_PIN=22
RFID_IN_SDA_PIN=8
RFID_IN_ENABLE=True

# PIN RFID OUT (lettore uscita)
RFID_OUT_RST_PIN=25
RFID_OUT_SDA_PIN=7
RFID_OUT_ENABLE=True

# ================================================
# ESEMPI DI CONFIGURAZIONE
# ================================================

# ESEMPIO 1: Solo MFRC522
# RFID_IN_READER_TYPE=mfrc522
# RFID_OUT_READER_TYPE=mfrc522

# ESEMPIO 2: Solo PN532
# RFID_IN_READER_TYPE=pn532
# RFID_OUT_READER_TYPE=pn532

# ESEMPIO 3: Mix (IN=MFRC522, OUT=PN532)
# RFID_IN_READER_TYPE=mfrc522
# RFID_OUT_READER_TYPE=pn532

# ESEMPIO 4: PN532 con SPI
# RFID_IN_READER_TYPE=pn532
# RFID_IN_PN532_INTERFACE=spi