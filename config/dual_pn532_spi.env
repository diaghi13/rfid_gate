# ===========================================
# 📋 CONFIGURAZIONE DUAL PN532 SPI
# ===========================================
# Configurazione per due PN532 sullo stesso bus SPI
# con Chip Select (CS) diversi

# Sistema bidirezionale
BIDIRECTIONAL_MODE=True
ENABLE_IN_READER=True
ENABLE_OUT_READER=True

# ===========================================
# 📱 LETTORE IN (PN532 SPI CS0)
# ===========================================
RFID_IN_READER_TYPE=pn532
RFID_IN_PN532_INTERFACE=spi
RFID_IN_PN532_SPI_BUS=0
RFID_IN_PN532_SPI_DEVICE=0        # /dev/spidev0.0 (CS0 = GPIO 8)

# ===========================================
# 📱 LETTORE OUT (PN532 SPI CS1) 
# ===========================================
RFID_OUT_READER_TYPE=pn532
RFID_OUT_PN532_INTERFACE=spi
RFID_OUT_PN532_SPI_BUS=0
RFID_OUT_PN532_SPI_DEVICE=1       # /dev/spidev0.1 (CS1 = GPIO 7)

# ===========================================
# 🔧 CONFIGURAZIONE RELAY
# ===========================================
RELAY_IN_PIN=18
RELAY_OUT_PIN=19
RELAY_ACTIVE_TIME=3.0

# ===========================================
# 🔧 JUMPER SETUP PN532 per SPI
# ===========================================
# ENTRAMBI i PN532 devono avere:
# SEL0 = L (Low)  
# SEL1 = H (High)
# 
# Su Waveshare PN532:
# LSB = ○ (vuoto)
# MSB = ● (jumper)

# ===========================================
# 📡 MQTT e Altri Settings
# ===========================================
MQTT_ENABLED=True
MQTT_BROKER=mqbrk.ddns.net
MQTT_PORT=8883
MQTT_USERNAME=gate_client
MQTT_PASSWORD=gate2024_secure!
MQTT_USE_TLS=True

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=True
ACCESS_LOG_FILE=logs/access_log.json

# Timing
CARD_READ_INTERVAL=0.1
DEBOUNCE_TIME=2.0