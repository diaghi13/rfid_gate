# ========================================
# 📄 .env - Configurazione Sistema RFID
# ========================================

# ===========================================
# 📡 CONFIGURAZIONE MQTT
# ===========================================
MQTT_BROKER=mqbrk.ddns.net
MQTT_PORT=8883
MQTT_USERNAME=palestraUser
MQTT_PASSWORD=28dade03$
MQTT_USE_TLS=True
MQTT_KEEP_ALIVE=60

# Topics MQTT
# MQTT_CARD_READ_TOPIC=rfid_gate/card_read
# MQTT_AUTH_RESPONSE_TOPIC=rfid_gate/auth_response
# MQTT_MANUAL_OPEN_TOPIC=rfid_gate/manual_open

MQTT_CARD_READ_TOPIC=gate/tornello_01/badge
MQTT_AUTH_RESPONSE_TOPIC=gate/tornello_01/response
MQTT_MANUAL_OPEN_TOPIC=gate/tornello_01/manual_open

# ✨ Configurazioni MQTT Parallelo e Logging (Nuove)
MQTT_PARALLEL_AUTH=True                    # MQTT parallelo, non-bloccante
MQTT_SYNC_LOGS_ONLY_ON_FAILURE=True      # Sync logs al server solo se MQTT fallisce
MQTT_ALWAYS_LOG_LOCALLY=True              # Log locali sempre salvati (per download/backup)
MQTT_ENABLE_RETRY_QUEUE=True              # Queue retry per connessioni perse
MQTT_MAX_RETRY_QUEUE_SIZE=1000            # Dimensione max queue retry
MQTT_RETRY_INTERVAL=30                    # Intervallo retry in secondi

# ===========================================
# 🏷️ IDENTIFICAZIONE TORNELLO
# ===========================================
TORNELLO_ID=tornello_01

# ===========================================
# 🔄 SISTEMA BIDIREZIONALE
# ===========================================
BIDIRECTIONAL_MODE=True
BIDIRECTIONAL_TIMEOUT_HOURS=6.0  # Reset stato direzione dopo 24 ore
ENABLE_IN_READER=True
ENABLE_OUT_READER=True      # Abilita lettore uscita (solo se BIDIRECTIONAL_MODE=True)

# ===========================================
# � CONFIGURAZIONE GPIO PINS
# ===========================================
# NOTA: Questi valori sono del sistema legacy FUNZIONANTE
# Modificare solo se necessario per hardware personalizzato
#
# Pin Mapping Raspberry Pi:
# - Pin 7 (GPIO 4)   = SDA_PIN per OUT reader  
# - Pin 8 (GPIO 14)  = SDA_PIN per IN reader
# - Pin 22 (GPIO 25) = RST_PIN per IN reader
# - Pin 25 (GPIO 6)  = RST_PIN per OUT reader
#
# Per PN532 SPI: SDA_PIN diventa CS (Chip Select) pin
# Per MFRC522:   SDA_PIN è il pin SDA standard

# ===========================================
# �🔵 LETTORE IN (PN532 I2C - Address 0x24)
# ===========================================
RFID_IN_ENABLED=true
RFID_IN_READER_TYPE=pn532
RFID_IN_PN532_INTERFACE=i2c
RFID_IN_PN532_I2C_ADDRESS=0x24
RFID_IN_PN532_SPI_BUS=0
RFID_IN_PN532_SPI_DEVICE=0
RFID_IN_PN532_UART_PORT=/dev/serial0
RFID_IN_PN532_UART_BAUDRATE=115200

# GPIO Configuration (Legacy System Values)
RFID_IN_RST_PIN=22
RFID_IN_SDA_PIN=8    # For MFRC522 SDA or PN532 CS pin

# ===========================================
# 🟡 LETTORE OUT (PN532 SPI - CS Pin 7)
# ===========================================
RFID_OUT_ENABLED=true
RFID_OUT_READER_TYPE=pn532
RFID_OUT_PN532_INTERFACE=spi
RFID_OUT_PN532_SPI_BUS=0
RFID_OUT_PN532_SPI_DEVICE=0
RFID_OUT_PN532_I2C_ADDRESS=0x25
RFID_OUT_PN532_UART_PORT=/dev/serial1
RFID_OUT_PN532_UART_BAUDRATE=115200

# GPIO Configuration (Legacy System Values)
RFID_OUT_RST_PIN=25
RFID_OUT_SDA_PIN=7   # For MFRC522 SDA or PN532 CS pin

# ===========================================
# 🔧 CONFIGURAZIONE RELAY
# ===========================================
# Relè IN
RELAY_IN_PIN=18
RELAY_IN_ACTIVE_TIME=1
RELAY_IN_ACTIVE_LOW=True
RELAY_IN_INITIAL_STATE=HIGH
RELAY_IN_ENABLE=True

# Relè OUT
RELAY_OUT_PIN=19
RELAY_OUT_ACTIVE_TIME=1
RELAY_OUT_ACTIVE_LOW=True
RELAY_OUT_INITIAL_STATE=HIGH
RELAY_OUT_ENABLE=True

# ===========================================
# 🔐 CONFIGURAZIONE AUTENTICAZIONE
# ===========================================
AUTH_ENABLED=True
AUTH_TIMEOUT=5
AUTH_TOPIC_SUFFIX=response

# ===========================================
# 🛠️ CONFIGURAZIONE APERTURA MANUALE
# ===========================================
MANUAL_OPEN_ENABLED=True
MANUAL_OPEN_TOPIC_SUFFIX=manual_open
MANUAL_OPEN_RESPONSE_TOPIC_SUFFIX=manual_response
MANUAL_OPEN_TIMEOUT=10
MANUAL_OPEN_AUTH_REQUIRED=True

# ===========================================
# 📴 CONFIGURAZIONE FALLBACK OFFLINE
# ===========================================
OFFLINE_MODE_ENABLED=True
OFFLINE_ALLOW_ACCESS=True
OFFLINE_SYNC_ENABLED=True
OFFLINE_STORAGE_FILE=logs/offline_queue.json
OFFLINE_MAX_QUEUE_SIZE=1000
CONNECTION_CHECK_INTERVAL=30
CONNECTION_RETRY_ATTEMPTS=3

# ===========================================
# � SISTEMA DI SINCRONIZZAZIONE
# ===========================================
SYNC_ENABLED=True
SYNC_SERVER_URL=https://gymme-newaction.ddns.net
SYNC_ENDPOINT=/api/sync-gate
SYNC_LOGS_ENDPOINT=/api/sync-gate/logs
SYNC_HEALTH_ENDPOINT=/api/health
SYNC_UPDATES_ENDPOINT=/api/sync-gate/updates
SYNC_DAILY_TIME=05:00
SYNC_UPDATES_INTERVAL=15
SYNC_LOGS_INTERVAL=5
SYNC_CONNECTION_TIMEOUT=30
SYNC_CACHE_DB_PATH=cache/local_cache.db
SYNC_MAX_PENDING_LOGS=1000
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY=5

# Configurazioni Cache Sync (per refresh cache dati)
CACHE_SYNC_SERVER_URL=https://gymme-newaction.ddns.net
CACHE_SYNC_ENDPOINT=/api/sync-gate
CACHE_SYNC_TIMEOUT=3

# Configurazioni REST per fallback real-time (solo per carte non in cache)
SYNC_FALLBACK_SERVER_URL=https://gymme-newaction.ddns.net
SYNC_FALLBACK_ENDPOINT=/api/gate-verification
SYNC_FALLBACK_TIMEOUT=3
SYNC_GATE_ID=tornello_01

# Endpoint specifico per gate-verification (CASO 2 fallback finale)
GATE_VERIFICATION_ENDPOINT=/api/gate-verification

# ===========================================
# 🔄 CACHE REFRESH STRATEGY
# ===========================================
CACHE_REFRESH_ENABLED=true                    # Abilita refresh intelligente
CACHE_REFRESH_TIMEOUT=5000                    # Timeout server check (ms)  
CACHE_REFRESH_COOLDOWN=300                    # Cooldown tra refresh (sec)
CACHE_REFRESH_SINGLE_CARD_ENDPOINT=/api/sync-gate  # Endpoint per carta singola con ?card_uid=
CACHE_REFRESH_MAX_RETRIES=2                   # Max retry per refresh falliti
CACHE_REFRESH_RETRY_DELAY=1000                # Delay tra retry (ms)

# ===========================================
# �📊 CONFIGURAZIONE LOGGING
# ===========================================
LOG_DIRECTORY=logs
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_FILE=logs/system.log
ACCESS_LOG_FILE=logs/access_log.json
LOG_RETENTION_DAYS=30
ENABLE_CONSOLE_LOG=True

# ===========================================
# ⏱️ CONFIGURAZIONE TIMING - OTTIMIZZATA ANTI-BLOCCO
# ===========================================
CARD_READ_INTERVAL=0.15
RFID_DEBOUNCE_TIME=1.0
MQTT_TIMEOUT=3

# ===========================================
# 🔧 GESTIONE ERRORI PN532 - DESIGN ROBUSTO  
# ===========================================
# Parametri ottimizzati per evitare blocchi del PN532
PN532_READ_TIMEOUT=0.01
PN532_MAX_ERRORS=3
PN532_RESET_DELAY=0.1

# Rate limiting per stabilità hardware
PN532_MIN_READ_INTERVAL=0.15
PN532_ERROR_COOLDOWN=0.5

# Anti-crosstalk per dual readers
GLOBAL_DEBOUNCE_TIME=0.8

# ===========================================
# 🏷️ CONFIGURAZIONE UID
# ===========================================
UID_FORMAT_MODE=fixed_length
UID_CHARS_COUNT=2
UID_TARGET_LENGTH=8
UID_DEBUG_MODE=True

# ===========================================
# 🎛️ CONFIGURAZIONE DEBUG
# ===========================================
DEBUG_MODE=False
SIMULATION_MODE=False

# ===========================================
# 📋 SCHEMA COLLEGAMENTO HARDWARE
# ===========================================
# 🔵 PN532 IN (I2C - Address 0x24):
#   VCC → 3.3V (Pin 1)
#   GND → GND (Pin 6)
#   SDA → GPIO 2 (Pin 3)
#   SCL → GPIO 3 (Pin 5)
#   Jumper: LSB=●, MSB=○ (I2C mode)
#
# 🟡 PN532 OUT (SPI - CS0):
#   VCC → 3.3V (Pin 17)
#   GND → GND (Pin 14)
#   MOSI → GPIO 10 (Pin 19)
#   MISO → GPIO 9 (Pin 21)
#   SCK → GPIO 11 (Pin 23)
#   NSS/CS → GPIO 8 (Pin 24)
#   Jumper: LSB=○, MSB=● (SPI mode)
#
# 🔧 RELAY:
#   IN → GPIO 18 (Pin 12)
#   OUT → GPIO 19 (Pin 35)