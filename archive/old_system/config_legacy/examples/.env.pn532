# ========================================
# 📄 CONFIGURAZIONE OTTIMIZZATA PN532
# ========================================
# Configurazione pronta per doppio lettore PN532

# ===========================================
# 📡 CONFIGURAZIONE MQTT
# ===========================================
MQTT_BROKER=mqbrk.ddns.net
MQTT_PORT=8883
MQTT_USERNAME=palestraUser
MQTT_PASSWORD=28dade03$
MQTT_USE_TLS=True

# ===========================================
# 🏷️ IDENTIFICAZIONE TORNELLO
# ===========================================
TORNELLO_ID=tornello_01

# ===========================================
# 🔄 SISTEMA BIDIREZIONALE PN532
# ===========================================
BIDIRECTIONAL_MODE=True
ENABLE_IN_READER=True
ENABLE_OUT_READER=True

# ===========================================
# 📱 LETTORI RFID PN532 (I2C)
# ===========================================
# LETTORE INGRESSO
RFID_IN_READER_TYPE=pn532
RFID_IN_PN532_INTERFACE=i2c
RFID_IN_PN532_I2C_ADDRESS=0x24
RFID_IN_ENABLE=True

# LETTORE USCITA
RFID_OUT_READER_TYPE=pn532
RFID_OUT_PN532_INTERFACE=i2c
RFID_OUT_PN532_I2C_ADDRESS=0x25
RFID_OUT_ENABLE=True

# ===========================================
# ⚡ CONFIGURAZIONE RELÈ
# ===========================================
# Relè INGRESSO
RELAY_IN_PIN=18
RELAY_IN_ACTIVE_TIME=2
RELAY_IN_ACTIVE_LOW=True
RELAY_IN_INITIAL_STATE=HIGH
RELAY_IN_ENABLE=True

# Relè USCITA
RELAY_OUT_PIN=19
RELAY_OUT_ACTIVE_TIME=2
RELAY_OUT_ACTIVE_LOW=True
RELAY_OUT_INITIAL_STATE=HIGH
RELAY_OUT_ENABLE=True

# ===========================================
# 🔐 AUTENTICAZIONE
# ===========================================
AUTH_ENABLED=True
AUTH_TIMEOUT=10
AUTH_TOPIC_SUFFIX=auth_response

# ===========================================
# 🔓 APERTURA MANUALE
# ===========================================
MANUAL_OPEN_ENABLED=True
MANUAL_OPEN_TOPIC_SUFFIX=manual_open
MANUAL_OPEN_RESPONSE_TOPIC_SUFFIX=manual_response
MANUAL_OPEN_TIMEOUT=10
MANUAL_OPEN_AUTH_REQUIRED=True

# ===========================================
# 🌐 SISTEMA OFFLINE
# ===========================================
OFFLINE_MODE_ENABLED=True
OFFLINE_ALLOW_ACCESS=True
OFFLINE_SYNC_ENABLED=True
OFFLINE_STORAGE_FILE=offline_queue.json
OFFLINE_MAX_QUEUE_SIZE=1000
CONNECTION_CHECK_INTERVAL=30
CONNECTION_RETRY_ATTEMPTS=3

# ===========================================
# 📊 LOGGING
# ===========================================
LOG_DIRECTORY=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
ENABLE_CONSOLE_LOG=True

# ===========================================
# 🔧 CONFIGURAZIONE RFID
# ===========================================
RFID_DEBOUNCE_TIME=1.5

# Formato UID ottimizzato per PN532
UID_FORMAT_MODE=remove_suffix
UID_CHARS_COUNT=2
UID_TARGET_LENGTH=8
UID_DEBUG_MODE=True

# ===========================================
# 📋 CABLAGGIO PN532 I2C
# ===========================================
# PN532 INGRESSO (Address 0x24):
#   VCC → 3.3V (Pin 1)
#   GND → GND  (Pin 6) 
#   SDA → GPIO 2 (Pin 3)
#   SCL → GPIO 3 (Pin 5)
#
# PN532 USCITA (Address 0x25):
#   VCC → 3.3V (Pin 17)
#   GND → GND  (Pin 20)
#   SDA → GPIO 2 (Pin 3) - CONDIVISO
#   SCL → GPIO 3 (Pin 5) - CONDIVISO
#
# RELÈ INGRESSO:
#   Signal → GPIO 18 (Pin 12)
#   VCC → 5V (Pin 2)
#   GND → GND (Pin 14)
#
# RELÈ USCITA:
#   Signal → GPIO 19 (Pin 35)
#   VCC → 5V (Pin 4)
#   GND → GND (Pin 34)

# ===========================================
# ✅ CONFIGURAZIONE TESTATA
# ===========================================
# Questa configurazione è ottimizzata per:
# - Doppio lettore PN532 su I2C
# - Sistema bidirezionale completo
# - Debounce ridotto per migliori prestazioni
# - Debug abilitato per troubleshooting