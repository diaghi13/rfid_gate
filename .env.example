# ========================================
# 📄 .env.example - Template Configurazione RFID Gate
# ========================================
#
# Copia questo file come .env e compila con i tuoi valori:
# cp .env.example .env
#
# ⚠️ IMPORTANTE: Non committare mai il file .env con credenziali reali!
#

# ===========================================
# 📡 CONFIGURAZIONE MQTT
# ===========================================
MQTT_BROKER=your-mqtt-broker.com
MQTT_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_USE_TLS=True
MQTT_KEEP_ALIVE=60

# Topics MQTT
MQTT_CARD_READ_TOPIC=rfid_gate/card_read
MQTT_AUTH_RESPONSE_TOPIC=rfid_gate/auth_response
MQTT_MANUAL_OPEN_TOPIC=rfid_gate/manual_open

# ✨ Configurazioni MQTT Parallelo e Logging (Nuove)
MQTT_PARALLEL_AUTH=true                    # MQTT parallelo, non-bloccante
MQTT_SYNC_LOGS_ONLY_ON_FAILURE=true      # Sync logs al server solo se MQTT fallisce
MQTT_ALWAYS_LOG_LOCALLY=true              # Log locali sempre salvati (per download/backup)
MQTT_ENABLE_RETRY_QUEUE=true              # Queue retry per connessioni perse
MQTT_MAX_RETRY_QUEUE_SIZE=1000            # Dimensione max queue retry
MQTT_RETRY_INTERVAL=30                    # Intervallo retry in secondi

# ===========================================
# 🏷️ IDENTIFICAZIONE TORNELLO
# ===========================================
TORNELLO_ID=tornello_01

# ===========================================
# 🔄 SISTEMA BIDIREZIONALE
# ===========================================
BIDIRECTIONAL_MODE=true
BIDIRECTIONAL_TIMEOUT_HOURS=24.0  # Reset stato direzione dopo 24 ore
ENABLE_IN_READER=true
ENABLE_OUT_READER=false      # Abilita per sistema dual reader

# ===========================================
# � CONFIGURAZIONE GPIO PINS
# ===========================================
# NOTA: Questi valori sono del sistema legacy FUNZIONANTE
# Modificare solo se necessario per hardware personalizzato
#
# Pin Mapping Raspberry Pi:
# - Pin 7 (GPIO 4)   = SDA_PIN per OUT reader  
# - Pin 8 (GPIO 14)  = SDA_PIN per IN reader
# - Pin 22 (GPIO 25) = RST_PIN per IN reader
# - Pin 25 (GPIO 6)  = RST_PIN per OUT reader
#
# Per PN532 SPI: SDA_PIN diventa CS (Chip Select) pin
# Per MFRC522:   SDA_PIN è il pin SDA standard

# ===========================================
# 🔵 LETTORE IN (PN532 I2C - Address 0x24)
# ===========================================
RFID_IN_ENABLED=true
RFID_IN_READER_TYPE=pn532
RFID_IN_PN532_INTERFACE=i2c
RFID_IN_PN532_I2C_ADDRESS=0x24
RFID_IN_PN532_SPI_BUS=0
RFID_IN_PN532_SPI_DEVICE=0
RFID_IN_PN532_UART_PORT=/dev/serial0
RFID_IN_PN532_UART_BAUDRATE=115200

# GPIO Configuration (Legacy System Values)
RFID_IN_RST_PIN=22    # For MFRC522 Reset or PN532 Reset pin
RFID_IN_SDA_PIN=8     # For MFRC522 SDA or PN532 CS pin

# ===========================================
# 🟡 LETTORE OUT (PN532 SPI - CS Pin 7)
# ===========================================
RFID_OUT_ENABLED=false
RFID_OUT_READER_TYPE=pn532
RFID_OUT_PN532_INTERFACE=spi
RFID_OUT_PN532_SPI_BUS=0
RFID_OUT_PN532_SPI_DEVICE=0
RFID_OUT_PN532_I2C_ADDRESS=0x25
RFID_OUT_PN532_UART_PORT=/dev/serial1
RFID_OUT_PN532_UART_BAUDRATE=115200

# GPIO Configuration (Legacy System Values)
RFID_OUT_RST_PIN=25   # For MFRC522 Reset or PN532 Reset pin
RFID_OUT_SDA_PIN=7    # For MFRC522 SDA or PN532 CS pin

# ===========================================
# 🔧 CONFIGURAZIONE RELAY
# ===========================================
# Relè IN
RELAY_IN_PIN=18
RELAY_IN_ACTIVE_TIME=1
RELAY_IN_ACTIVE_LOW=true
RELAY_IN_INITIAL_STATE=HIGH
RELAY_IN_ENABLE=true

# Relè OUT
RELAY_OUT_PIN=19
RELAY_OUT_ACTIVE_TIME=1
RELAY_OUT_ACTIVE_LOW=true
RELAY_OUT_INITIAL_STATE=HIGH
RELAY_OUT_ENABLE=false      # Abilita per dual relay

# ===========================================
# ⚡ CONFIGURAZIONE RELÈ
# ===========================================
RELAY_IN_ENABLE=true
RELAY_IN_PIN=18
RELAY_IN_ACTIVE_TIME=1
RELAY_IN_ACTIVE_LOW=false
RELAY_IN_INITIAL_STATE=LOW

RELAY_OUT_ENABLE=false
RELAY_OUT_PIN=19
RELAY_OUT_ACTIVE_TIME=1
RELAY_OUT_ACTIVE_LOW=false
RELAY_OUT_INITIAL_STATE=LOW

# ===========================================
# 🔐 AUTENTICAZIONE
# ===========================================
AUTH_ENABLED=true
AUTH_TIMEOUT=5
AUTH_TOPIC_SUFFIX=auth_response

# Apertura Manuale
MANUAL_OPEN_ENABLED=true
MANUAL_OPEN_TOPIC_SUFFIX=manual_open
MANUAL_OPEN_RESPONSE_TOPIC_SUFFIX=manual_response
MANUAL_OPEN_TIMEOUT=10
MANUAL_OPEN_AUTH_REQUIRED=true

# ===========================================
# 📴 MODALITÀ OFFLINE
# ===========================================
OFFLINE_MODE_ENABLED=true
OFFLINE_ALLOW_ACCESS=true
OFFLINE_SYNC_ENABLED=true
OFFLINE_STORAGE_FILE=offline_queue.json
OFFLINE_MAX_QUEUE_SIZE=1000
CONNECTION_CHECK_INTERVAL=30
CONNECTION_RETRY_ATTEMPTS=3

# ===========================================
# � SISTEMA DI SINCRONIZZAZIONE
# ===========================================
# Abilita sistema offline-first con cache locale
SYNC_ENABLED=true

# Configurazione server per sincronizzazione
SYNC_SERVER_URL=https://gymme-newaction.ddns.net
SYNC_ENDPOINT=/api/sync-gate
SYNC_LOGS_ENDPOINT=/api/sync-gate/logs
SYNC_HEALTH_ENDPOINT=/api/health
SYNC_UPDATES_ENDPOINT=/api/sync-gate/updates

# Timing sincronizzazione
SYNC_DAILY_TIME=06:00                    # Ora sync completa giornaliera (HH:MM)
SYNC_UPDATES_INTERVAL=15                # Minuti tra check aggiornamenti
SYNC_LOGS_INTERVAL=5                    # Minuti tra sync log
SYNC_CONNECTION_TIMEOUT=30              # Secondi timeout connessione

# Database cache locale
SYNC_CACHE_DB_PATH=cache/local_cache.db
SYNC_MAX_PENDING_LOGS=1000

# Retry e resilienza
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY=5                      # Secondi tra tentativi

# ===========================================
# �📊 LOGGING
# ===========================================
LOG_DIRECTORY=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
ENABLE_CONSOLE_LOG=false

# ===========================================
# ⏱️ TIMING E DEBOUNCE
# ===========================================
RFID_DEBOUNCE_TIME=2.0
CARD_READ_INTERVAL=0.15
GLOBAL_DEBOUNCE_TIME=0.8
MQTT_TIMEOUT=3

# PN532 Advanced Configuration
PN532_READ_TIMEOUT=0.01
PN532_MAX_ERRORS=3
PN532_RESET_DELAY=0.1
PN532_MIN_READ_INTERVAL=0.15
PN532_ERROR_COOLDOWN=0.5

# ===========================================
# 🏷️ FORMATO UID
# ===========================================
UID_FORMAT_MODE=remove_suffix  # remove_suffix | fixed_length | raw
UID_CHARS_COUNT=2
UID_TARGET_LENGTH=8
UID_DEBUG_MODE=false

# ===========================================
# 🎛️ DEBUG E SIMULAZIONE
# ===========================================
DEBUG_MODE=false
SIMULATION_MODE=false

# ===========================================
# 🚀 ESEMPI CONFIGURAZIONI COMUNI
# ===========================================

# --- Single PN532 Reader (Sistema Legacy) ---
# BIDIRECTIONAL_MODE=false
# ENABLE_IN_READER=true
# ENABLE_OUT_READER=false
# RFID_IN_READER_TYPE=pn532
# RFID_IN_PN532_INTERFACE=i2c
# RFID_IN_RST_PIN=22
# RFID_IN_SDA_PIN=8

# --- Dual PN532 Readers (Sistema Legacy Completo) ---
# BIDIRECTIONAL_MODE=true
# ENABLE_IN_READER=true
# ENABLE_OUT_READER=true
# RFID_IN_READER_TYPE=pn532
# RFID_OUT_READER_TYPE=pn532
# RFID_IN_PN532_INTERFACE=i2c
# RFID_OUT_PN532_INTERFACE=spi
# RFID_IN_RST_PIN=22
# RFID_IN_SDA_PIN=8
# RFID_OUT_RST_PIN=25
# RFID_OUT_SDA_PIN=7

# --- Dual MFRC522 Readers (Alternative) ---
# BIDIRECTIONAL_MODE=true
# ENABLE_IN_READER=true
# ENABLE_OUT_READER=true
# RFID_IN_READER_TYPE=mfrc522
# RFID_OUT_READER_TYPE=mfrc522
# RFID_IN_RST_PIN=22
# RFID_IN_SDA_PIN=24
# RFID_OUT_RST_PIN=25
# RFID_OUT_SDA_PIN=8

# --- Configurazioni Timeout Personalizzate ---
# BIDIRECTIONAL_TIMEOUT_HOURS=12.0    # Reset ogni 12 ore
# BIDIRECTIONAL_TIMEOUT_HOURS=72.0    # Reset ogni 3 giorni
# BIDIRECTIONAL_TIMEOUT_HOURS=1.0     # Reset ogni ora (test)

# --- MQTT Locale (senza TLS) ---
# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_USE_TLS=false

# --- Debug Mode ---
# LOG_LEVEL=DEBUG
# ENABLE_CONSOLE_LOG=true
# UID_DEBUG_MODE=true

# ===========================================
# 🔥 CONFIGURAZIONE FALLBACK REST REAL-TIME
# ===========================================
# Queste configurazioni gestiscono il fallback REST per risolvere il "gap di sync".
# Quando una carta viene registrata nel sistema centrale ma non è ancora nel cache
# locale (durante i 15 minuti di intervallo sync), il sistema effettua una chiamata
# REST real-time per verificare immediatamente l'autorizzazione.

# Server e endpoint per fallback real-time
SYNC_FALLBACK_SERVER_URL=https://your-server.com
SYNC_FALLBACK_ENDPOINT=/api/gate-verification
SYNC_FALLBACK_TIMEOUT=3
SYNC_GATE_ID=tornello_01

# Payload inviato: {"uid": "CARD123", "direction": "in", "gate_id": "tornello_01"}
# Risposta attesa: {"uid": "CARD123", "authorized": true, "message": "...", "identificativo_tornello": "tornello_01"}