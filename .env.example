# ========================================
# 📄 .env.example - Template Configurazione RFID Gate
# ========================================
# 
# 📋 Copia questo file come .env e compila con i tuoi valori:
# cp .env.example .env
#
# ⚠️ IMPORTANTE: Non committare mai il file .env con credenziali reali!
#

# ===========================================
# 📡 CONFIGURAZIONE MQTT
# ===========================================
MQTT_BROKER=your-mqtt-broker.com
MQTT_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_USE_TLS=True
MQTT_KEEP_ALIVE=60

# Topics MQTT
MQTT_CARD_READ_TOPIC=rfid_gate/card_read
MQTT_AUTH_RESPONSE_TOPIC=rfid_gate/auth_response
MQTT_MANUAL_OPEN_TOPIC=rfid_gate/manual_open

# ===========================================
# 🏷️ IDENTIFICAZIONE TORNELLO
# ===========================================
TORNELLO_ID=tornello_01

# ===========================================
# 🔄 SISTEMA BIDIREZIONALE
# ===========================================
BIDIRECTIONAL_MODE=true
ENABLE_IN_READER=true
ENABLE_OUT_READER=false      # Abilita per dual reader

# ===========================================
# 📡 CONFIGURAZIONE LETTORI RFID
# ===========================================

# Tipo lettori: mfrc522 | pn532
RFID_IN_READER_TYPE=mfrc522
RFID_OUT_READER_TYPE=mfrc522

# --- MFRC522 Configuration ---
RFID_IN_RST_PIN=22
RFID_IN_SDA_PIN=8
RFID_OUT_RST_PIN=25
RFID_OUT_SDA_PIN=7

# --- PN532 Configuration IN ---
RFID_IN_PN532_INTERFACE=i2c    # i2c | spi | uart
RFID_IN_PN532_I2C_ADDRESS=0x24
RFID_IN_PN532_SPI_BUS=0
RFID_IN_PN532_SPI_DEVICE=0
RFID_IN_PN532_UART_PORT=/dev/serial0
RFID_IN_PN532_UART_BAUDRATE=115200

# --- PN532 Configuration OUT ---
RFID_OUT_PN532_INTERFACE=spi   # Diverso dal IN per dual reader
RFID_OUT_PN532_I2C_ADDRESS=0x25
RFID_OUT_PN532_SPI_BUS=1
RFID_OUT_PN532_SPI_DEVICE=0
RFID_OUT_PN532_UART_PORT=/dev/serial1
RFID_OUT_PN532_UART_BAUDRATE=115200

# ===========================================
# ⚡ CONFIGURAZIONE RELÈ
# ===========================================
RELAY_IN_ENABLE=true
RELAY_IN_PIN=18
RELAY_IN_ACTIVE_TIME=2
RELAY_IN_ACTIVE_LOW=false
RELAY_IN_INITIAL_STATE=LOW

RELAY_OUT_ENABLE=false
RELAY_OUT_PIN=19
RELAY_OUT_ACTIVE_TIME=2
RELAY_OUT_ACTIVE_LOW=false
RELAY_OUT_INITIAL_STATE=LOW

# ===========================================
# 🔐 AUTENTICAZIONE
# ===========================================
AUTH_ENABLED=true
AUTH_TIMEOUT=5
AUTH_TOPIC_SUFFIX=auth_response

# Apertura Manuale
MANUAL_OPEN_ENABLED=true
MANUAL_OPEN_TOPIC_SUFFIX=manual_open
MANUAL_OPEN_RESPONSE_TOPIC_SUFFIX=manual_response
MANUAL_OPEN_TIMEOUT=10
MANUAL_OPEN_AUTH_REQUIRED=true

# ===========================================
# 📴 MODALITÀ OFFLINE
# ===========================================
OFFLINE_MODE_ENABLED=true
OFFLINE_ALLOW_ACCESS=true
OFFLINE_SYNC_ENABLED=true
OFFLINE_STORAGE_FILE=offline_queue.json
OFFLINE_MAX_QUEUE_SIZE=1000
CONNECTION_CHECK_INTERVAL=30
CONNECTION_RETRY_ATTEMPTS=3

# ===========================================
# 📊 LOGGING
# ===========================================
LOG_DIRECTORY=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
ENABLE_CONSOLE_LOG=false

# ===========================================
# ⏱️ TIMING E DEBOUNCE
# ===========================================
RFID_DEBOUNCE_TIME=2.0
CARD_READ_INTERVAL=0.15
GLOBAL_DEBOUNCE_TIME=0.8

# ===========================================
# 🏷️ FORMATO UID
# ===========================================
UID_FORMAT_MODE=remove_suffix  # remove_suffix | fixed_length | raw
UID_CHARS_COUNT=2
UID_TARGET_LENGTH=8
UID_DEBUG_MODE=false

# ===========================================
# 🚀 ESEMPI CONFIGURAZIONI COMUNI
# ===========================================

# --- Single MFRC522 Reader ---
# BIDIRECTIONAL_MODE=false
# ENABLE_IN_READER=true
# ENABLE_OUT_READER=false
# RFID_IN_READER_TYPE=mfrc522

# --- Dual PN532 Readers (I2C + SPI) ---
# BIDIRECTIONAL_MODE=true
# ENABLE_IN_READER=true
# ENABLE_OUT_READER=true
# RFID_IN_READER_TYPE=pn532
# RFID_OUT_READER_TYPE=pn532
# RFID_IN_PN532_INTERFACE=i2c
# RFID_OUT_PN532_INTERFACE=spi

# --- MQTT Locale (senza TLS) ---
# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_USE_TLS=false

# --- Debug Mode ---
# LOG_LEVEL=DEBUG
# ENABLE_CONSOLE_LOG=true
# UID_DEBUG_MODE=true