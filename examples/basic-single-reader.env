# ========================================
# 📄 Basic Single Reader Configuration
# ========================================
# 
# Configurazione base per sistema con singolo lettore RFID
# Ideale per: Ingressi semplici, uffici piccoli, test iniziali
#

# ===========================================
# 📡 MQTT CONFIGURATION
# ===========================================
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=rfid_user
MQTT_PASSWORD=your_secure_password
MQTT_USE_TLS=false
MQTT_KEEP_ALIVE=60

# Topics MQTT
MQTT_CARD_READ_TOPIC=gate/entrance/badge
MQTT_AUTH_RESPONSE_TOPIC=gate/entrance/response
MQTT_MANUAL_OPEN_TOPIC=gate/entrance/manual_open

# ===========================================
# 🏷️ SYSTEM IDENTIFICATION
# ===========================================
TORNELLO_ID=entrance_gate_01

# ===========================================
# 🔄 SINGLE READER MODE
# ===========================================
BIDIRECTIONAL_MODE=false
ENABLE_IN_READER=true
ENABLE_OUT_READER=false

# ===========================================
# 🔧 RFID READER CONFIGURATION
# ===========================================
# Lettore principale (IN)
RFID_IN_ENABLED=true
RFID_IN_READER_TYPE=mfrc522
RFID_IN_RST_PIN=22
RFID_IN_SDA_PIN=8

# Lettore OUT disabilitato
RFID_OUT_ENABLED=false

# ===========================================
# 🎛️ RELAY CONFIGURATION
# ===========================================
RELAY_IN_PIN=18
RELAY_IN_ACTIVATION_TIME=2.0
RELAY_IN_NORMALLY_OPEN=true

# ===========================================
# 🌐 SERVER ENDPOINTS
# ===========================================
SERVER_URL=https://your-server.com
GATE_VERIFICATION_ENDPOINT=/api/gate-verification
SYNC_ENDPOINT=/api/sync-gate
SYNC_LOGS_ENDPOINT=/api/sync-gate/logs

# ===========================================
# 💾 CACHE & OFFLINE
# ===========================================
SYNC_ENABLED=true
CACHE_REFRESH_ENABLED=true
CACHE_REFRESH_TIMEOUT=3000
CACHE_REFRESH_COOLDOWN=300

# ===========================================
# 📊 LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/system.log
LOG_MAX_SIZE=10
LOG_BACKUP_COUNT=5

# ===========================================
# 🔐 SECURITY
# ===========================================
# Formattazione UID (uppercase, no separatori)
UID_FORMAT=uppercase_no_separators

# Timeout generali
CONNECTION_TIMEOUT=30
MANUAL_OPEN_TIMEOUT=10

# ===========================================
# 💡 NOTES
# ===========================================
# - Configurazione base per test e piccoli uffici
# - MQTT senza TLS (solo per reti locali sicure)
# - Singolo lettore MFRC522 standard
# - Cache refresh abilitato per sincronizzazione
# - Logging standard per troubleshooting