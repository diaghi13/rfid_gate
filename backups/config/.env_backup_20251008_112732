# ========================================
# 📄 .env - Configurazione Sistema RFID
# ========================================

# ===========================================
# 📡 CONFIGURAZIONE MQTT
# ===========================================
MQTT_BROKER=mqbrk.ddns.netMQTT_PORT=8883MQTT_USERNAME=palestraUserMQTT_PASSWORD=28dade03$MQTT_USE_TLS=TrueMQTT_KEEP_ALIVE=60
# Topics MQTT
MQTT_CARD_READ_TOPIC=rfid_gate/card_readMQTT_AUTH_RESPONSE_TOPIC=rfid_gate/auth_responseMQTT_MANUAL_OPEN_TOPIC=rfid_gate/manual_open
# ===========================================
# 🏷️ IDENTIFICAZIONE TORNELLO
# ===========================================
TORNELLO_ID=tornello_01
# ===========================================
# 🔄 SISTEMA BIDIREZIONALE
# ===========================================
BIDIRECTIONAL_MODE=TrueENABLE_IN_READER=TrueENABLE_OUT_READER=True  Abilita lettore uscita (solo se BIDIRECTIONAL_MODE=True)

# ===========================================
# 🔵 LETTORE IN (PN532 I2C - Address 0x24)
# ===========================================
RFID_IN_READER_TYPE=pn532RFID_IN_PN532_INTERFACE=i2cRFID_IN_PN532_I2C_ADDRESS=0x24RFID_IN_ENABLE=True
# ===========================================
# 🟡 LETTORE OUT (PN532 SPI - CS0)
# ===========================================
RFID_OUT_READER_TYPE=pn532RFID_OUT_PN532_INTERFACE=spiRFID_OUT_PN532_SPI_BUS=0RFID_OUT_PN532_SPI_DEVICE=0RFID_OUT_ENABLE=True
# ===========================================
# 🔧 CONFIGURAZIONE RELAY
# ===========================================
# Relè IN
RELAY_IN_PIN=18RELAY_IN_ACTIVE_TIME=3RELAY_IN_ACTIVE_LOW=TrueRELAY_IN_INITIAL_STATE=HIGHRELAY_IN_ENABLE=True
# Relè OUT
RELAY_OUT_PIN=19RELAY_OUT_ACTIVE_TIME=3RELAY_OUT_ACTIVE_LOW=TrueRELAY_OUT_INITIAL_STATE=HIGHRELAY_OUT_ENABLE=True
# ===========================================
# 🔐 CONFIGURAZIONE AUTENTICAZIONE
# ===========================================
AUTH_ENABLED=TrueAUTH_TIMEOUT=5AUTH_TOPIC_SUFFIX=auth_response
# ===========================================
# 🛠️ CONFIGURAZIONE APERTURA MANUALE
# ===========================================
MANUAL_OPEN_ENABLED=TrueMANUAL_OPEN_TOPIC_SUFFIX=manual_openMANUAL_OPEN_RESPONSE_TOPIC_SUFFIX=manual_responseMANUAL_OPEN_TIMEOUT=10MANUAL_OPEN_AUTH_REQUIRED=True
# ===========================================
# 📴 CONFIGURAZIONE FALLBACK OFFLINE
# ===========================================
OFFLINE_MODE_ENABLED=TrueOFFLINE_ALLOW_ACCESS=TrueOFFLINE_SYNC_ENABLED=TrueOFFLINE_STORAGE_FILE=logs/offline_queue.jsonOFFLINE_MAX_QUEUE_SIZE=1000CONNECTION_CHECK_INTERVAL=30CONNECTION_RETRY_ATTEMPTS=3
# ===========================================
# 📊 CONFIGURAZIONE LOGGING
# ===========================================
LOG_DIRECTORY=logsLOG_LEVEL=INFOLOG_TO_FILE=TrueLOG_FILE=logs/system.logACCESS_LOG_FILE=logs/access_log.jsonLOG_RETENTION_DAYS=30ENABLE_CONSOLE_LOG=True
# ===========================================
# ⏱️ CONFIGURAZIONE TIMING - OTTIMIZZATA ANTI-BLOCCO
# ===========================================
CARD_READ_INTERVAL=0.15RFID_DEBOUNCE_TIME=1.0MQTT_TIMEOUT=3
# ===========================================
# 🔧 GESTIONE ERRORI PN532 - DESIGN ROBUSTO  
# ===========================================
# Parametri ottimizzati per evitare blocchi del PN532
PN532_READ_TIMEOUT=0.01PN532_MAX_ERRORS=3PN532_RESET_DELAY=0.1
# Rate limiting per stabilità hardware
PN532_MIN_READ_INTERVAL=0.15PN532_ERROR_COOLDOWN=0.5
# Anti-crosstalk per dual readers
GLOBAL_DEBOUNCE_TIME=0.8
# ===========================================
# 🏷️ CONFIGURAZIONE UID
# ===========================================
UID_FORMAT_MODE=fixed_lengthUID_CHARS_COUNT=2UID_TARGET_LENGTH=8UID_DEBUG_MODE=True
# ===========================================
# 🎛️ CONFIGURAZIONE DEBUG
# ===========================================
DEBUG_MODE=FalseSIMULATION_MODE=False
# ===========================================
# 📋 SCHEMA COLLEGAMENTO HARDWARE
# ===========================================
# 🔵 PN532 IN (I2C - Address 0x24):
#   VCC → 3.3V (Pin 1)
#   GND → GND (Pin 6)
#   SDA → GPIO 2 (Pin 3)
#   SCL → GPIO 3 (Pin 5)
#   Jumper: LSB=●, MSB=○ (I2C mode)
#
# 🟡 PN532 OUT (SPI - CS0):
#   VCC → 3.3V (Pin 17)
#   GND → GND (Pin 14)
#   MOSI → GPIO 10 (Pin 19)
#   MISO → GPIO 9 (Pin 21)
#   SCK → GPIO 11 (Pin 23)
#   NSS/CS → GPIO 8 (Pin 24)
#   Jumper: LSB=○, MSB=● (SPI mode)
#
# 🔧 RELAY:
#   IN → GPIO 18 (Pin 12)
#   OUT → GPIO 19 (Pin 35)
# Configurazioni aggiunte automaticamente
TEST_DEMO=demo_value_112426
